#!/usr/bin/env bash
set -euo pipefail
python3 - <<'PY'
from pathlib import Path
required = ["lab1", "lab2", "lab3", "lab4", "lab5", "lab6", "lab7", "README.md"]
missing = [p for p in required if not Path(p).exists()]
if missing:
    raise SystemExit(f"Missing required lab assets: {missing}")
print("Required lab structure present")
PY

for f in AGENTS.md .github/BRANCH_POLICY.md .github/BRANCH_PROTECTION.md .github/PULL_REQUEST_TEMPLATE.md; do
  test -f "$f"
done

npx -y markdown-link-check AGENTS.md -q || true
npx -y markdown-link-check .github/BRANCH_POLICY.md -q || true
npx -y markdown-link-check .github/BRANCH_PROTECTION.md -q || true
