#!/usr/bin/env bash
set -euo pipefail
python3 - <<'PY'
from pathlib import Path
required = ["lab1", "lab2", "lab3", "lab4", "lab5", "lab6", "lab7", "README.md"]
missing = [p for p in required if not Path(p).exists()]
if missing:
    raise SystemExit(f"Missing required lab assets: {missing}")
print("Required lab structure present")
PY
npx -y markdownlint-cli2 "**/*.md" "#node_modules"
while IFS= read -r -d '' f; do
  npx -y markdown-link-check "$f" -q || true
done < <(find . -name '*.md' -print0)
